<UserControl x:Class="InventoryManagement.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Báo cáo &amp; Phân tích" FontSize="26" FontWeight="Bold" Foreground="#0F274C" Margin="0,0,0,12"/>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- First Row: Main filters -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="Kho:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboWarehouse" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/>
                <TextBlock Text="Nhà cung cấp:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboSupplier" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/>
                <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboProduct" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/>
            </StackPanel>
            
            <!-- Second Row: Date filters and buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Top N:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtTopN" Width="60" Text="10" VerticalContentAlignment="Center"/>
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpFrom" Width="140"/>
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpTo" Width="140"/>
                <Button Content="Làm mới" Margin="16,0,0,0" Padding="12,6" Click="BtnRefresh_Click" Background="#1976D2" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                <Button Content="Xuất Excel" Margin="8,0,0,0" Padding="12,6" Click="BtnExport_Click" Background="#2E7D32" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- KPI Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,12,0" Padding="12" Background="White" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Tổng sản phẩm" FontWeight="SemiBold" Foreground="#1565C0"/>
                    <TextBlock x:Name="TxtTotalProducts" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,12,0" Padding="12" Background="White" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Tổng tồn kho" FontWeight="SemiBold" Foreground="#1565C0"/>
                    <TextBlock x:Name="TxtTotalStock" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,12,0" Padding="12" Background="White" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Nhập trong kỳ" FontWeight="SemiBold" Foreground="#1565C0"/>
                    <TextBlock x:Name="TxtImported" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="12" Background="White" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Xuất trong kỳ" FontWeight="SemiBold" Foreground="#1565C0"/>
                    <TextBlock x:Name="TxtExported" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabs with advanced analytics -->
        <TabControl Grid.Row="3">
            <TabItem Header="Tồn kho">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="DgStockByProduct" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36" Margin="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" AlternatingRowBackground="#F8F9FA" FontSize="13" HorizontalGridLinesBrush="#E0E0E0" BorderBrush="#BBDEFB" BorderThickness="1">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#BBDEFB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" Width="2*"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Giao dịch theo ngày">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="DgTransactions" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36"
                              CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" AlternatingRowBackground="#F8F9FA" FontSize="13" HorizontalGridLinesBrush="#E0E0E0" BorderBrush="#BBDEFB" BorderThickness="1">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#BBDEFB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                            <DataGridTextColumn Header="Nhập" Binding="{Binding Imported}" Width="*"/>
                            <DataGridTextColumn Header="Xuất" Binding="{Binding Exported}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Top Nhập/Xuất">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="DgTopProducts" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36"
                              Background="White" AlternatingRowBackground="#F8F9FA" FontSize="13" BorderBrush="#BBDEFB" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="Nhập" Binding="{Binding Imported}" Width="*"/>
                            <DataGridTextColumn Header="Xuất" Binding="{Binding Exported}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Top Nhà cung cấp">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="DgTopSuppliers" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36"
                              Background="White" AlternatingRowBackground="#F8F9FA" FontSize="13" BorderBrush="#BBDEFB" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="Tổng nhập" Binding="{Binding TotalImported}" Width="*"/>
                            <DataGridTextColumn Header="Tổng xuất" Binding="{Binding TotalExported}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Cảnh báo tồn thấp">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="DgLowStock" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36"
                              Background="White" AlternatingRowBackground="#FFF3E0" FontSize="13" BorderBrush="#FF9800" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" Width="2*"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="*"/>
                            <DataGridTextColumn Header="Ngưỡng" Binding="{Binding Threshold}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>